# -----------------------------------------------------------------------------
# OnboardAI — copy to .env and adjust values:
#   cp .env.example .env
#
# Host-local API/bot: keep localhost in DATABASE_URL / REDIS_URL / API_BASE_URL.
# Docker Compose overrides those for the api/bot/frontend containers automatically.
# -----------------------------------------------------------------------------

# Application
APP_NAME=OnboardAI
APP_ENV=development
DEBUG=true
# Use >= 32 random bytes in production (JWT HMAC)
SECRET_KEY=dev-only-change-me-to-a-long-random-secret

# Auth / JWT (MVP login: username = employee UUID, password = AUTH_PASSWORD)
AUTH_PASSWORD=change-me-auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Platform Super Admin (separate from company tenants)
SUPER_ADMIN_EMAIL=superadmin@onboard.local
SUPER_ADMIN_PASSWORD=change-me-super-admin
SUPER_ADMIN_FULL_NAME=Super Admin

# Bot → API service token (opaque shared secret; NOT AUTH_PASSWORD)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_SERVICE_TOKEN=change-me-bot-service-token
# Rate limit for POST /api/v1/auth/bot/telegram (per client IP)
BOT_LOGIN_RATE_LIMIT=30
BOT_LOGIN_RATE_WINDOW_SECONDS=60

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Admin panel (Compose frontend service)
FRONTEND_PORT=3000

# Seed demo company/HR/admin/employee on API startup (Compose)
SEED_DEMO=true

# Employee invite flow (Super Admin creates users without sending passwords)
INVITE_TTL_HOURS=24
INVITE_BASE_URL=http://localhost:3000
# Optional SMTP — when unset, invite URLs are logged by the API
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@onboard.local
SMTP_USE_TLS=true

# Telegram / aiogram
# Leave BOT_TOKEN empty to keep the bot container idle (API + frontend still work).
# For local Telegram testing: set BOT_TOKEN from @BotFather and leave BOT_WEBHOOK_URL
# empty to use polling. For servers: set BOT_WEBHOOK_URL to a public HTTPS URL.
BOT_TOKEN=
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_PATH=/webhook
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8081
# Demo seed company id (scripts/seed_demo.py). Override if you use another tenant.
BOT_COMPANY_ID=11111111-1111-4111-8111-111111111111
# Local bot process → API on host. Compose bot service uses http://api:8000
API_BASE_URL=http://localhost:8000

# PostgreSQL (Compose service: db)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=onboard
POSTGRES_PASSWORD=onboard
POSTGRES_DB=onboard_ai
DATABASE_URL=postgresql+asyncpg://onboard:onboard@localhost:5432/onboard_ai

# Redis (Compose service: redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
