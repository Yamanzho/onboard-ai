# -----------------------------------------------------------------------------
# OnboardAI — copy to .env and adjust values:
#   cp .env.example .env
#
# Host-local API/bot: keep localhost in DATABASE_URL / REDIS_URL / API_BASE_URL.
# Docker Compose overrides those for the api/bot/frontend containers automatically.
# -----------------------------------------------------------------------------

# Application
APP_NAME=OnboardAI
APP_ENV=development
DEBUG=true
# JWT HMAC secret.
# Development: any non-empty value is fine for local work.
# Production (APP_ENV=production): REQUIRED — unique random, >= 32 chars.
#   Rejected: empty, short, and obvious defaults/placeholders (fail-fast).
#   Generate:  openssl rand -hex 32
#          or: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do NOT copy a placeholder value into production.
SECRET_KEY=<generate-a-strong-random-secret>

# Auth / JWT (MVP login: username = employee UUID)
# Shared AUTH_PASSWORD is for local/demo users without password_hash only.
# Forced off when APP_ENV=production. Prefer invite-set personal passwords.
# Demo/local default below is development-only — never reuse in production.
AUTH_PASSWORD=change-me-auth
ALLOW_SHARED_AUTH_PASSWORD=true
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Password login rate limit (employee + Super Admin, per client IP)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# Invite preview / accept rate limits (per client IP)
INVITE_PREVIEW_RATE_LIMIT=30
INVITE_PREVIEW_RATE_WINDOW_SECONDS=60
INVITE_ACCEPT_RATE_LIMIT=10
INVITE_ACCEPT_RATE_WINDOW_SECONDS=60
# Refresh rotation rate limits (tenant + Super Admin, per client IP; keys separated)
# Generous vs login: multi-tab browsers + bot shared egress IP refresh routinely.
REFRESH_RATE_LIMIT=120
REFRESH_RATE_WINDOW_SECONDS=60
# Client IP for rate limits. Default false — ignore X-Forwarded-For / X-Real-IP.
# Enable ONLY when:
#   1) a trusted reverse proxy overwrites these headers, AND
#   2) the API is not reachable directly from the public internet
#      (use docker-compose.prod.yml — API has no host port; traffic via frontend nginx).
# Local Compose publishes API:8000 for Swagger/curl — keep this false there.
TRUST_PROXY_HEADERS=false

# Platform Super Admin (separate from company tenants)
# Bootstrap runs on API start (docker/entrypoint-api.sh → seed_super_admin).
# Production: REQUIRED — unique strong password (>= 12 chars); defaults/placeholders rejected.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(24))"
SUPER_ADMIN_EMAIL=superadmin@onboard.local
SUPER_ADMIN_PASSWORD=<set-a-strong-unique-password>
SUPER_ADMIN_FULL_NAME=Super Admin

# Bot → API service token (opaque shared secret; NOT AUTH_PASSWORD)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# When BOT_COMPANY_ID is set on the API, bot login is bound to that company only.
# Production: required by docker-compose.prod.yml; must be >= 24 chars and not a
# placeholder. BOT_COMPANY_ID is required with the token and must NOT be the
# demo seed id 11111111-1111-4111-8111-111111111111.
BOT_SERVICE_TOKEN=<generate-a-strong-bot-service-token>
# Rate limit for POST /api/v1/auth/bot/telegram (per client IP)
BOT_LOGIN_RATE_LIMIT=30
BOT_LOGIN_RATE_WINDOW_SECONDS=60

# Auth / JWT
# HS256 access tokens include exact iss/aud (F-09). Override only if you run
# multiple isolated OnboardAI deployments that must not accept each other's JWTs.
JWT_ISSUER=onboard-ai
JWT_AUDIENCE=onboard-ai-api
API_PORT=8000

# Admin panel (Compose frontend service)
FRONTEND_PORT=3000

# Seed demo company/HR/admin/employee on API startup (Compose) — opt-in
# Production Compose forces SEED_DEMO=false. The API entrypoint refuses true
# when APP_ENV=production (no demo tenant in a pilot).
SEED_DEMO=false

# Employee invite flow (Super Admin / tenant HR create users without sending passwords)
INVITE_TTL_HOURS=24
# Production (APP_ENV=production): MUST be https://<public-host> (fail-fast otherwise).
INVITE_BASE_URL=http://localhost:3000
# Optional SMTP — when unset, invite send is logged without the token URL
# -----------------------------------------------------------------------------
# SMTP (invite emails)
# Production: set SMTP_HOST to actually send mail. When SMTP_HOST is empty OR
# SMTP delivery fails, the API creates the invite and returns
# invite_url / invite_delivery=manual_url — it does NOT claim email_sent=true.
# When SMTP succeeds: invite_email_sent=true, invite_delivery=email.
#
# Put real credentials ONLY in the VPS .env (never commit them).
# Supported settings names (pydantic): SMTP_HOST, SMTP_PORT, SMTP_USER,
# SMTP_PASSWORD, SMTP_FROM, SMTP_USE_TLS.
#
# aoe.kz SPF already includes _spf.ps.kz — preferred path is a PS.KZ mailbox:
#   SMTP_HOST=mail.aoe.kz          # per PS.KZ docs: mail.<domain>
#   SMTP_PORT=465                  # implicit SSL (API uses SMTP_SSL on 465)
#   SMTP_USE_TLS=true              # ignored for port 465; used for 587 STARTTLS
#   SMTP_USER=full-mailbox@aoe.kz
#   SMTP_PASSWORD=<mailbox password>
#   SMTP_FROM=noreply@aoe.kz       # must be an address the mailbox may send as
# Or port 587 + STARTTLS if your provider documents that instead of 465.
# Do NOT use no-reply@onboardai.aoe.kz until that mailbox/DNS is provisioned.
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@onboard.local
SMTP_USE_TLS=true

# Telegram / aiogram
# Leave BOT_TOKEN empty to keep the bot container idle (API + frontend still work).
# For local Telegram testing: set BOT_TOKEN from @BotFather and leave BOT_WEBHOOK_URL
# empty to use polling. For servers: set BOT_WEBHOOK_URL to a public HTTPS URL and
# ALWAYS set BOT_WEBHOOK_SECRET.
# NEVER run two pollers with the same BOT_TOKEN (e.g. local Docker + VPS) —
# Telegram returns Conflict: terminated by other getUpdates request.
BOT_TOKEN=
# Public bot username (no @) for employee invite "Open Telegram" links.
TELEGRAM_BOT_USERNAME=
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
BOT_WEBHOOK_PATH=/webhook
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8081
# Demo seed company id (scripts/seed_demo.py). Override if you use another tenant.
# Must match on API and bot — API rejects bot logins for other company_ids.
# Production: docker-compose.prod.yml requires BOT_COMPANY_ID; Settings rejects
# this demo UUID. After Super Admin creates the pilot company, set this to that id.
BOT_COMPANY_ID=11111111-1111-4111-8111-111111111111
# Local bot process → API on host. Compose bot service uses http://api:8000
API_BASE_URL=http://localhost:8000

# PostgreSQL (Compose service: db)
# Development (local / default docker compose):
#   Default credentials onboard/onboard are fine for local work.
#   Compose publishes Postgres on 127.0.0.1 only (not LAN/public).
#   Containers override DATABASE_URL to use host `db` on the Compose network.
# Production (docker-compose.prod.yml):
#   POSTGRES_PASSWORD is REQUIRED (compose fails if missing/empty).
#   Do NOT use the development default "onboard" — Settings rejects weak
#   DATABASE_URL passwords when APP_ENV=production (>= 12 chars, not known defaults).
#   Compose does NOT publish Postgres ports (internal network only, like Redis).
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
#          or: openssl rand -hex 32
#   Then set DATABASE_URL to embed the same password (Compose api service
#   builds DATABASE_URL from POSTGRES_* automatically).
#
# F-03 WARNING — existing postgres_data volume:
#   Changing POSTGRES_PASSWORD here does NOT rotate the live PostgreSQL role.
#   Postgres applies POSTGRES_PASSWORD only on first volume initialization.
#   Application roles: ONBOARD_APP_PASSWORD / ONBOARD_OWNER_PASSWORD are synced by
#   scripts/bootstrap_rls_roles.py on API start (ALTER ROLE).
#   Bootstrap role: use ALTER ROLE / \password inside Postgres, then update this file.
#   Do NOT delete postgres_data to "rotate" a password.
#   Runbook: docs/runbooks/postgres-password-rotation.md
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=onboard
POSTGRES_PASSWORD=onboard
POSTGRES_DB=onboard_ai
# SEC-R3: dual roles — runtime app vs migrator/owner (BYPASSRLS).
# Bootstrap superuser remains POSTGRES_USER (creates roles on API start).
ONBOARD_OWNER_PASSWORD=onboard
ONBOARD_APP_PASSWORD=onboard
DATABASE_URL=postgresql+asyncpg://onboard_app:onboard@localhost:5432/onboard_ai
MIGRATION_DATABASE_URL=postgresql+asyncpg://onboard_owner:onboard@localhost:5432/onboard_ai
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://onboard:onboard@localhost:5432/onboard_ai
# Required for production compose (docker-compose.prod.yml). Override the
# development default above — never ship "onboard" as the production password.
# POSTGRES_PASSWORD=<generate-a-strong-random-password>
# ONBOARD_OWNER_PASSWORD=<generate-a-strong-random-password>
# ONBOARD_APP_PASSWORD=<generate-a-strong-random-password>

# Redis
# Development (local / default docker compose):
#   No password. Compose publishes Redis on 127.0.0.1 only (not LAN/public).
#   Containers override REDIS_URL to redis://redis:6379/0 on the Compose network.
#   API/bot bind-mount .:/app and may use uvicorn --reload (dev only).
# Production (docker-compose.prod.yml):
#   Immutable images (no source bind-mounts). Forces APP_ENV=production (no --reload).
#   Set a strong REDIS_PASSWORD (required). Compose enables --requirepass and
#   does NOT publish Redis ports. API/bot get:
#     REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
#   Redis is REQUIRED in production: bot FSM and login rate limits fail hard
#   (no MemoryStorage / per-process memory fallback). See DEPLOYMENT.md (P1-REDIS).
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
#          or: openssl rand -hex 32
#   Use URL-safe characters so the password needs no URL-encoding.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
# Required for production compose (docker-compose.prod.yml). Leave unset in development.
# REDIS_PASSWORD=<generate-a-strong-random-password>

# -----------------------------------------------------------------------------
# AI embeddings
# Dev/CI: FakeEmbeddingProvider (deterministic, in-process, no network).
# Production hosted: OpenAI text-embedding-3-small (1536-d). After switching
# provider or dimension, reindex the tenant:
#   POST /api/v1/knowledge/articles/reindex-published
#   or: python -m scripts.reindex_published_kb --company-id <uuid>
# Never commit API keys. Never log them.
# -----------------------------------------------------------------------------
AI_EMBEDDING_PROVIDER=fake
AI_EMBEDDING_DIMENSION=1536
AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_API_KEY=
# OPENAI_API_KEY is accepted as an alias for AI_EMBEDDING_API_KEY
AI_EMBEDDING_TIMEOUT_SECONDS=30
# AI-7 live retrieval evaluation (never set in CI). Requires a key and --live-openai:
#   ONBOARDAI_AI7_LIVE_OPENAI=1 python -m scripts.evaluate_kb_retrieval --live-openai
#   ONBOARDAI_AI7_LIVE_OPENAI=1 python -m scripts.evaluate_rag --live-openai
# ONBOARDAI_AI7_LIVE_OPENAI=
# -----------------------------------------------------------------------------
# AI LLM (AI-9A service + AI-9B POST /api/v1/ai/chat). Telegram is a thin client (AI-9C).
# Dev/CI: FakeLLMProvider. Production hosted: OpenAI Chat Completions.
# Never commit API keys. Never log them.
# -----------------------------------------------------------------------------
AI_LLM_PROVIDER=fake
AI_LLM_MODEL=gpt-4o-mini
# AI_LLM_API_KEY=
# OPENAI_API_KEY is accepted as an alias for AI_LLM_API_KEY
AI_LLM_TIMEOUT_SECONDS=30
# AI-10A reliability. Chat budget stays below the Telegram HTTP timeout (30s).
AI_PROVIDER_MAX_RETRIES=2
AI_PROVIDER_RETRY_BACKOFF_SECONDS=0.2
AI_PROVIDER_RETRY_MAX_BACKOFF_SECONDS=2
AI_CHAT_TIMEOUT_SECONDS=25
# Per authenticated employee. 0 disables. Not an authorization mechanism.
AI_CHAT_RATE_LIMIT=20
AI_CHAT_RATE_WINDOW_SECONDS=60
# AI-11C: Redis TTL for the Telegram current-conversation pointer (seconds).
# Conversation rows stay in PostgreSQL; this is only the ephemeral session key.
AI_TELEGRAM_CONVERSATION_TTL_SECONDS=86400
