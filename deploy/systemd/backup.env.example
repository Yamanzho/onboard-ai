# Copy to /etc/onboard-ai/backup.env, replace placeholders, then chmod 600.
# This file is loaded by host systemd only. Do not expose it to API/bot containers.

BACKUP_COMPOSE_DIR=/opt/onboard-ai
BACKUP_LOCAL_DIR=/var/backups/onboard-ai
BACKUP_STATUS_FILE=/var/lib/onboard-ai-backup/last-backup.json
BACKUP_VERIFY_STATUS_FILE=/var/lib/onboard-ai-backup/last-restore-verification.json
# Output consumed by node_exporter's textfile collector.
MONITORING_TEXTFILE_OUTPUT=/var/lib/node_exporter/textfile_collector/onboardai_backup.prom

POSTGRES_DB=onboard_ai
ONBOARD_OWNER_PASSWORD=<production-onboard-owner-password>

BACKUP_S3_ENDPOINT=https://s3-compatible.example.invalid
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=<private-backup-bucket>
BACKUP_S3_PREFIX=onboardai/postgres
BACKUP_S3_ACCESS_KEY_ID=<prefix-scoped-access-key>
BACKUP_S3_SECRET_ACCESS_KEY=<prefix-scoped-secret-key>
BACKUP_S3_SSE=AES256
# For BACKUP_S3_SSE=aws:kms, set the provider-specific key identifier.
BACKUP_S3_KMS_KEY_ID=

BACKUP_RETENTION_DAYS=30

# Pilot default: keep backup/restore Prometheus alerts silent until off-host
# backup is intentionally enabled. Set to 1 only after S3 config, first remote
# backup, restore verification, and timers are active.
ONBOARDAI_BACKUP_ENFORCEMENT=0
